# Archivo de ejemplo de variables de entorno
# Este archivo se sube al repositorio como guía
# Cada desarrollador debe copiarlo a .env y ajustar valores locales

# API
API_BASE_URL=http://api:8000

# Base de datos
DB_HOST=db
DB_PORT=1433
DB_NAME=LibrarySystem
DB_USER=sa
DB_PASSWORD=SuperSecret123

# Seguridad
JWT_SECRET=ChangeThisSecretKey
JWT_EXPIRATION_MINUTES=60

# Logging
LOG_LEVEL=Information

# Volumenes de datos
UID=1000
GID=1000
